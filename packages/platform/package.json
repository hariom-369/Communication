{
  "name": "@tessera/platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Server runtime foundations shared by Tessera services: config, logging, errors, health, lifecycle.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/memory-destination.d.ts",
      "default": "./dist/testing/memory-destination.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@tessera/shared": "workspace:*",
    "@tessera/validation": "workspace:*",
    "fastify": "5.12.5",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "prom-client": "15.1.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
