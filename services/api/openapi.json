{
  "openapi": "3.1.0",
  "info": {
    "title": "Tessera API",
    "version": "v1"
  },
  "components": {
    "schemas": {}
  },
  "paths": {
    "/api/v1/meta/version": {
      "get": {
        "operationId": "meta.version",
        "summary": "API, build and protocol version",
        "tags": [
          "meta"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "api": {
                      "type": "string",
                      "enum": [
                        "v1"
                      ]
                    },
                    "build": {
                      "type": "object",
                      "properties": {
                        "version": {
                          "type": "string"
                        },
                        "commit": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "version",
                        "commit"
                      ],
                      "additionalProperties": false
                    },
                    "protocol": {
                      "type": "object",
                      "properties": {
                        "current": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "minimumSupported": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "current",
                        "minimumSupported"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "api",
                    "build",
                    "protocol"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "4XX": {
            "description": "Error (RFC 9457 problem details)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string",
                      "enum": [
                        "BAD_REQUEST",
                        "VALIDATION_FAILED",
                        "UNAUTHENTICATED",
                        "FORBIDDEN",
                        "CSRF_REJECTED",
                        "NOT_FOUND",
                        "METHOD_NOT_ALLOWED",
                        "CONFLICT",
                        "PAYLOAD_TOO_LARGE",
                        "UNSUPPORTED_MEDIA_TYPE",
                        "RATE_LIMITED",
                        "SERVICE_UNAVAILABLE",
                        "INTERNAL"
                      ]
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer",
                      "minimum": 400,
                      "maximum": 599
                    },
                    "detail": {
                      "type": "string"
                    },
                    "requestId": {
                      "type": "string"
                    },
                    "errorId": {
                      "type": "string"
                    },
                    "retryAfterSeconds": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "fieldErrors": {
                      "maxItems": 50,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string"
                          },
                          "message": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "path",
                          "message"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "type",
                    "code",
                    "title",
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "5XX": {
            "description": "Error (RFC 9457 problem details)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string",
                      "enum": [
                        "BAD_REQUEST",
                        "VALIDATION_FAILED",
                        "UNAUTHENTICATED",
                        "FORBIDDEN",
                        "CSRF_REJECTED",
                        "NOT_FOUND",
                        "METHOD_NOT_ALLOWED",
                        "CONFLICT",
                        "PAYLOAD_TOO_LARGE",
                        "UNSUPPORTED_MEDIA_TYPE",
                        "RATE_LIMITED",
                        "SERVICE_UNAVAILABLE",
                        "INTERNAL"
                      ]
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer",
                      "minimum": 400,
                      "maximum": 599
                    },
                    "detail": {
                      "type": "string"
                    },
                    "requestId": {
                      "type": "string"
                    },
                    "errorId": {
                      "type": "string"
                    },
                    "retryAfterSeconds": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "fieldErrors": {
                      "maxItems": 50,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string"
                          },
                          "message": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "path",
                          "message"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "type",
                    "code",
                    "title",
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  }
}
