# @tessera/api configuration. Copy to .env for local development only; never commit .env.
# Every variable is validated at boot (src/config.ts); the process refuses to start on errors.

NODE_ENV=development
HOST=0.0.0.0
PORT=8080
# Internal health server (/livez, /readyz, /startupz). Never expose publicly.
HEALTH_PORT=9090
LOG_LEVEL=info
# Include messages/stacks of unexpected errors in logs. Must be false in production.
LOG_ERROR_DETAILS=true

DATABASE_URL=postgres://tessera:tessera@localhost:5432/tessera
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=5000
VALKEY_URL=redis://localhost:6379
VALKEY_KEY_PREFIX=tessera

# Comma-separated browser origins allowed for CORS and CSRF checks. https only in production.
ALLOWED_ORIGINS=http://localhost:5173
# Number of trusted reverse-proxy hops in front of the API (0 = direct).
TRUST_PROXY_HOPS=0
BODY_LIMIT_BYTES=65536

PUBLIC_WEB_URL=http://localhost:5173
# Local Mailpit (infra/docker/compose.yaml); production: smtps:// relay (e.g. Amazon SES).
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Tessera <no-reply@tessera.localhost>
# Generate each key with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Production values come from the secret manager, never from files.
PASSWORD_PEPPER=p1:REPLACE_WITH_BASE64_32_BYTES
SECRET_BOX_KEYS=k1:REPLACE_WITH_BASE64_32_BYTES
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Tessera
MAILBOX_RETENTION_DAYS=30
# Requests per minute per client address, all routes (users behind one NAT share it).
IP_FLOOD_LIMIT_PER_MINUTE=1200
# How often scheduled channel posts are published (milliseconds).
CHANNEL_SCHEDULER_INTERVAL_MS=15000
REALTIME_WS_PATH=/rt/v1/ws
SESSION_IDLE_DAYS=30
SESSION_ABSOLUTE_DAYS=90

# Encrypted attachments (docs/media.md §5). Local MinIO from infra/docker/compose.yaml;
# production: an S3 bucket in the deployment region, accessed with the instance role (no keys).
MEDIA_S3_BUCKET=tessera-e2ee-media
MEDIA_S3_REGION=ap-south-1
MEDIA_S3_ENDPOINT=http://localhost:9000
MEDIA_S3_FORCE_PATH_STYLE=true
MEDIA_S3_ACCESS_KEY_ID=tessera-local
MEDIA_S3_SECRET_ACCESS_KEY=REPLACE_WITH_LOCAL_MINIO_PASSWORD

BUILD_VERSION=0.0.0-dev
BUILD_COMMIT=unknown
SHUTDOWN_DRAIN_MS=5000
SHUTDOWN_TIMEOUT_MS=25000
