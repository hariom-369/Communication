# @tessera/api configuration. Copy to .env for local development only; never commit .env.
# Every variable is validated at boot (src/config.ts); the process refuses to start on errors.

NODE_ENV=development
HOST=0.0.0.0
PORT=8080
# Internal health server (/livez, /readyz, /startupz). Never expose publicly.
HEALTH_PORT=9090
LOG_LEVEL=info
# Include messages/stacks of unexpected errors in logs. Must be false in production.
LOG_ERROR_DETAILS=true

DATABASE_URL=postgres://tessera:tessera@localhost:5432/tessera
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=5000
VALKEY_URL=redis://localhost:6379
VALKEY_KEY_PREFIX=tessera

# Comma-separated browser origins allowed for CORS and CSRF checks. https only in production.
ALLOWED_ORIGINS=http://localhost:5173
# Number of trusted reverse-proxy hops in front of the API (0 = direct).
TRUST_PROXY_HOPS=0
# Pending-connection queue (capped by net.core.somaxconn; docs/capacity.md §4).
LISTEN_BACKLOG=4096
# Realtime tickets per second across the cluster; 0 = unlimited (default; docs/capacity.md §4).
REALTIME_TICKETS_PER_SECOND=0
BODY_LIMIT_BYTES=65536

PUBLIC_WEB_URL=http://localhost:5173
# Local Mailpit (infra/docker/compose.yaml); production: smtps:// relay (e.g. Amazon SES).
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Tessera <no-reply@tessera.localhost>
# Generate each key with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Production values come from the secret manager, never from files.
PASSWORD_PEPPER=p1:REPLACE_WITH_BASE64_32_BYTES
SECRET_BOX_KEYS=k1:REPLACE_WITH_BASE64_32_BYTES
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Tessera
MAILBOX_RETENTION_DAYS=30
# Requests per minute per client address, all routes (users behind one NAT share it).
IP_FLOOD_LIMIT_PER_MINUTE=1200
# How often scheduled channel posts are published (milliseconds).
CHANNEL_SCHEDULER_INTERVAL_MS=15000
REALTIME_WS_PATH=/rt/v1/ws
SESSION_IDLE_DAYS=30
SESSION_ABSOLUTE_DAYS=90

# Encrypted attachments (docs/media.md §5). Local MinIO from infra/docker/compose.yaml;
# production: an S3 bucket in the deployment region, accessed with the instance role (no keys).
MEDIA_S3_BUCKET=tessera-e2ee-media
MEDIA_S3_REGION=ap-south-1
MEDIA_S3_ENDPOINT=http://localhost:9000
MEDIA_S3_FORCE_PATH_STYLE=true
MEDIA_S3_ACCESS_KEY_ID=tessera-local
MEDIA_S3_SECRET_ACCESS_KEY=REPLACE_WITH_LOCAL_MINIO_PASSWORD

# Calls (docs/calling.md §8). TURN relay: coturn started with infra/calls/turnserver.conf and the
# same shared secret (--static-auth-secret). Leave both unset to run without a relay.
TURN_URLS=turn:127.0.0.1:3478?transport=udp
TURN_SHARED_SECRET=REPLACE_WITH_A_LOCAL_SECRET_OF_AT_LEAST_32_CHARACTERS
TURN_TTL_SECONDS=600
# Group calls: LiveKit (infra/calls/livekit.dev.yaml), reached by browsers at /sfu on the web
# origin. Leave all four unset to run without group calls.
LIVEKIT_URL=/sfu
LIVEKIT_API_URL=http://127.0.0.1:7880
LIVEKIT_API_KEY=tessera-dev
LIVEKIT_API_SECRET=REPLACE_WITH_A_LOCAL_SECRET_OF_AT_LEAST_32_CHARACTERS
CALL_RECORD_RETENTION_DAYS=90
CALL_SWEEP_INTERVAL_MS=15000

# Web Push (docs/notifications.md). Generate a key pair with `npx web-push generate-vapid-keys`
# and keep the private key secret. Without these, push notifications are unavailable.
VAPID_PUBLIC_KEY=REPLACE_WITH_YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=REPLACE_WITH_YOUR_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:ops@tessera.localhost
# Push services pushes may go to (default: FCM, Mozilla, Apple, Windows).
# PUSH_SERVICE_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,push.apple.com,notify.windows.com
NOTIFY_INTERVAL_MS=1000
SECURITY_ALERT_RETENTION_DAYS=180

# Moderation (docs/moderation.md). Required in production; without them, reports cannot carry
# messages and messages are not franked.
# Franking key ring for message franking tags (ADR-021): "<id>:<base64 32 bytes>", newest first.
#   node -e "console.log('f1:' + require('crypto').randomBytes(32).toString('base64'))"
# FRANKING_KEYS=REPLACE_WITH_f1:BASE64_32_BYTES
# HPKE key pair (P-256) report bundles are encrypted to; the private key belongs in the secrets
# manager. Generate: node -e "const e=require('crypto').createECDH('prime256v1');e.generateKeys();
#   console.log(e.getPublicKey().toString('base64url'), e.getPrivateKey().toString('base64url'))"
# MODERATION_HPKE_PUBLIC_KEY=REPLACE_WITH_BASE64URL_PUBLIC_KEY
# MODERATION_HPKE_PRIVATE_KEY=REPLACE_WITH_BASE64URL_PRIVATE_KEY
MODERATION_SWEEP_INTERVAL_MS=60000
EVIDENCE_RETENTION_DAYS=365

# Admin console (docs/admin.md, ADR-050): a separate process (`pnpm start:admin`) on its own
# port and origin. Staff sign in with the corporate identity provider, then a security key.
ADMIN_PORT=8082
ADMIN_HEALTH_PORT=9092
ADMIN_ORIGINS=http://localhost:5174
ADMIN_PUBLIC_URL=http://localhost:5174
# ADMIN_OIDC_ISSUER=https://login.example.com
# ADMIN_OIDC_CLIENT_ID=tessera-admin
# ADMIN_OIDC_CLIENT_SECRET=REPLACE_WITH_THE_CLIENT_SECRET_FROM_YOUR_IDENTITY_PROVIDER
ADMIN_EMAIL_DOMAINS=tessera.localhost
# Local identity provider over http only; refused in production.
ADMIN_OIDC_ALLOW_INSECURE=false
# ADMIN_WEBAUTHN_RP_ID=localhost
# Approved security-key models (AAGUIDs) and the vendors' attestation roots (PEM bundle) to check
# them against; both or neither. Empty = any hardware-bound (non-synced) key.
# ADMIN_AUTHENTICATOR_AAGUIDS=
# ADMIN_ATTESTATION_ROOTS_FILE=/etc/tessera/security-key-roots.pem
ADMIN_SESSION_IDLE_MINUTES=30
ADMIN_SESSION_ABSOLUTE_HOURS=8

# Billing (docs/billing.md). Each provider: all settings or none. Price maps name the provider's
# price (Stripe) or plan (Razorpay) id for each Tessera plan code.
# STRIPE_SECRET_KEY=REPLACE_WITH_YOUR_STRIPE_SECRET_KEY
# STRIPE_WEBHOOK_SECRET=REPLACE_WITH_YOUR_STRIPE_WEBHOOK_SIGNING_SECRET
# STRIPE_PRICES=premium_monthly=price_REPLACE,premium_yearly=price_REPLACE,creator_monthly=price_REPLACE
# RAZORPAY_KEY_ID=REPLACE_WITH_YOUR_RAZORPAY_KEY_ID
# RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_RAZORPAY_KEY_SECRET
# RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_YOUR_RAZORPAY_WEBHOOK_SECRET
# RAZORPAY_PLANS=premium_monthly=plan_REPLACE,premium_yearly=plan_REPLACE,creator_monthly=plan_REPLACE
# Seller on tax invoices (required with any provider). State: ISO 3166-2:IN code, e.g. KA.
# BILLING_SELLER_NAME=Your Company Private Limited
# BILLING_SELLER_ADDRESS=Registered office address
# BILLING_SELLER_GSTIN=REPLACE_WITH_YOUR_GSTIN
# BILLING_SELLER_STATE=KA
BILLING_SAC_CODE=998439

BUILD_VERSION=0.0.0-dev
BUILD_COMMIT=unknown
SHUTDOWN_DRAIN_MS=5000
SHUTDOWN_TIMEOUT_MS=25000
