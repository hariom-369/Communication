# Isolated link-preview fetcher (src/fetcher-server.ts, docs/security.md §6). It needs no
# database, Valkey, object storage or keys. Copy to .env.fetcher for local use; never commit it.
NODE_ENV=development
HOST=127.0.0.1
PORT=8083
HEALTH_PORT=9093
LOG_LEVEL=info
# Shared with the API's LINK_PREVIEW_FETCHER_TOKEN; at least 32 characters, from the secrets
# manager in deployed environments.
FETCHER_TOKEN=
# Requests handled at once; more are answered 503 with Retry-After.
FETCHER_MAX_CONCURRENT=32
