# @tessera/realtime configuration (validated at boot; see src/config.ts). Never commit .env.
NODE_ENV=development
HOST=0.0.0.0
PORT=8081
HEALTH_PORT=9091
LOG_LEVEL=info
LOG_ERROR_DETAILS=true
# Read-only use of the API's database (sessions, conversation membership).
# Production: a dedicated role with SELECT on those tables only.
DATABASE_URL=postgres://tessera:tessera-local-only@localhost:5432/tessera
VALKEY_URL=redis://localhost:6379
VALKEY_KEY_PREFIX=tessera
ALLOWED_ORIGINS=http://localhost:5173
WS_PATH=/rt/v1/ws
MAX_CONNECTIONS=50000
MAX_CONNECTIONS_PER_USER=10
HEARTBEAT_SECONDS=25
