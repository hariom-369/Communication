# Build-time settings for the web app's release step (scripts/release.mjs, ADR-052).
# None are needed for development or tests: without a signing key, builds are signed with a
# throwaway key and marked unofficial. Never commit real values.

# Base64 PKCS#8 (DER) Ed25519 private key that signs release.json. Release pipeline only.
RELEASE_SIGNING_KEY=
# Base64 raw Ed25519 public keys trusted for the next release besides the signer (key rotation),
# comma-separated.
RELEASE_NEXT_KEYS=
# 1 in production pipelines: a build without RELEASE_SIGNING_KEY fails.
RELEASE_REQUIRE_OFFICIAL=
# Monotonically increasing release number (defaults to the build time in milliseconds).
RELEASE_SEQUENCE=
BUILD_VERSION=
BUILD_COMMIT=
